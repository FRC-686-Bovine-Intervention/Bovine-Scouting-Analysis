{
    "firestore":  {
                      "rules":  "firestore.rules"
                  },
    "hosting":  [
        {
            "target": "desktop",
            "public":  ".",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**",
                                   ".pnpm-store/**"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                    }
                ]
        },
        {
            "target": "mobile",
            "public": ".",
            "ignore": ["firebase.json", "index.html", "**/.*", "**/node_modules/**", ".pnpm-store/**"],
            "rewrites": [{"source": "**", "destination": "/mobile.html"}]
        }
    ],
    "functions":  {
                      "source":  "functions"
                  },
    "emulators": {
                      "auth": { "port": 9099 },
                      "firestore": { "port": 8080 },
                      "ui": { "enabled": true, "port": 4000 }
                  }
}
