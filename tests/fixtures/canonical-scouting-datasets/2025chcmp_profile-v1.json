      {
        "name": "auto",
        "formula": "average(scouting.autoL3Made * 6 + scouting.autoL2Made * 4 + scouting.autoTroughMade * 3 + scouting.autoProcessorMade * 6 + scouting.autoBargeMade * 4)"
      },
      {
        "name": "avgClimbScoreOverAttempts",
        "formula": "average(if(scouting.climbHeight == 3, 12, if(scouting.climbHeight == 2, 6, if(scouting.climbHeight == 1, 2, 0))), scouting.climbAttempt > 0)"
      },
      {
        "name": "climb",
        "formula": "average(if(scouting.climbHeight == 3, 12, if(scouting.climbHeight == 2, 6, if(scouting.climbHeight == 1, 2, 0))))"
      },
      {
        "name": "coral",
        "formula": "average(scouting.teleL4Made * 5 + scouting.teleL3Made * 4 + scouting.teleL2Made * 3 + scouting.teleTroughMade * 2)"
      },
      {
        "name": "scoutingTotal",
        "formula": "auto + coral + algae + climb"
      }
