        "aggregate": "average"
      },
      {
        "id": "autoAmpMissed",
        "label": "Auto Amp Missed",
        "type": "number",
        "unit": "notes",
        "optional": false,
        "aggregate": "average"
      },
      {
        "id": "teleSpeakerMade",
        "label": "Teleop Speaker Made",
        "type": "number",
        "unit": "notes",
        "optional": false,
        "aggregate": "average"
      },
      {
        "id": "teleSpeakerMissed",
        "label": "Teleop Speaker Missed",
        "type": "number",
        "unit": "notes",
        "optional": false,
        "aggregate": "average"
      },
      {
        "id": "teleAmpMade",
        "label": "Teleop Amp Made",
        "type": "number",
        "unit": "notes",
        "optional": false,
        "aggregate": "average"
      },
      {
        "id": "teleAmpMissed",
        "label": "Teleop Amp Missed",
        "type": "number",
        "unit": "notes",
