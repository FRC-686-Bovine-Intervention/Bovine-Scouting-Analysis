      },
      {
        "id": "climbSuccess",
        "label": "Climb Success",
        "type": "number",
        "unit": "count",
        "optional": false,
        "aggregate": "average"
      },
      {
        "id": "driverPerformance",
        "label": "Driver Performance",
        "type": "number",
        "unit": "rating",
        "optional": true,
        "aggregate": "average"
      },
      {
        "id": "defenseOnThemRating",
        "label": "Defense On Them",
