      },
      {
        "id": "autoSpeakerMissed",
        "label": "Auto Speaker Missed",
        "type": "number",
        "unit": "notes",
        "optional": false,
        "aggregate": "average"
      },
      {
        "id": "autoAmpMade",
        "label": "Auto Amp Made",
        "type": "number",
